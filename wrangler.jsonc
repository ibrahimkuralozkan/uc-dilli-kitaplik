{
  "name": "ikodynamics-kitaplik",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "build": {
    "command": "node scripts/build-site.cjs"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "AUTH_ENABLED": "false",
    "ALLOW_SIGNUP": "false"
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
